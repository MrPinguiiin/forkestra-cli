{
  "name": "forkestra-cli",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "libsql": "0.5.29",
      "hono": "^4.12.32",
      "@trpc/server": "^11.18.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "compile:server": "turbo run compile -F server --",
    "compile:cli": "turbo run compile -F @forkestra-cli/cli --",
    "lint": "biome lint --vcs-enabled=false apps/server/src packages/*/src package.json turbo.json bts.jsonc",
    "format": "biome format --write --vcs-enabled=false apps/server/src packages/*/src package.json turbo.json bts.jsonc",
    "check-types": "turbo run check-types",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @forkestra-cli/db --",
    "db:studio": "turbo run db:studio -F @forkestra-cli/db --",
    "db:generate": "turbo run db:generate -F @forkestra-cli/db --",
    "db:migrate": "turbo run db:migrate -F @forkestra-cli/db --",
    "db:local": "turbo run db:local -F @forkestra-cli/db --"
  },
  "dependencies": {
    "@forkestra-cli/env": "workspace:*",
    "@opentui/core": "^0.5.8",
    "commander": "^15.0.0",
    "dotenv": "catalog:",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@forkestra-cli/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
